# Copy this file to .env and fill it in (or paste the block from `issue-keys`).
# Real environment variables take precedence over this file.
# Lines are KEY=value. Lines starting with # are comments. Quotes are optional.

# Your Email Bison address (the URL you log in at).
IC_BISON_URL=https://mail.example.com

# One set per client. <SLUG> is the client's slug, upper-cased.
# The _NAME line is optional: it sets the display name when there is no clients.json (e.g. in a cloud routine).
IC_ACME_NAME=Acme Corp
IC_ACME_BISON_KEY=replace-with-your-bison-key
IC_ACME_HEYREACH_KEY=replace-with-your-heyreach-key

# Optional: show report times in your local time zone (default UTC). Also decides when it's Monday.
# IC_TIMEZONE=America/New_York

# Optional: if you run it several times a day, list the run times (24h, in IC_TIMEZONE) so each run
# only counts replies since the previous one. Days default to mon-fri.
# IC_SCHEDULE=12:00,15:00,19:00
# IC_SCHEDULE_DAYS=mon-fri

# Admin only, admin's computer only. Never in a cloud environment, routine, chat or git.
# BISON_MASTER_KEY=
# HEYREACH_ORG_KEY=
